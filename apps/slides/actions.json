{
  "id": "yavc.slides",
  "version": "1.0.0",
  "apiVersion": 1,
  "title": "Slides",
  "description": "Slide decks as Markdown files: read, build and change a deck, move through it, and present it. The deck a live action works on is the one open in Slides; parse and make work on text alone.",
  "module": "actions.js",
  "actions": [
    {
      "ref": "yavc.slides/parse@1",
      "title": "Parse a Deck",
      "description": "Read a deck's Markdown into its front matter and its slides. Slides are divided by a line of three dashes; a {{slide:…}} line gives a slide's settings; {{notes}} … {{/notes}} is what the speaker says.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/parsed",
        "$defs": {
          "parsed": {
            "$ref": "#/$defs/deck"
          },
          "deck": {
            "type": "object",
            "required": [
              "front",
              "slides"
            ],
            "properties": {
              "front": {
                "$ref": "#/$defs/front"
              },
              "slides": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slide"
                }
              }
            },
            "$defs": {}
          },
          "front": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "theme": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "transition": {
                "type": "string"
              }
            }
          },
          "slide": {
            "type": "object",
            "required": [
              "index",
              "title",
              "settings",
              "text"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      },
      "capabilities": [],
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/make@1",
      "title": "Make a Deck",
      "description": "Write a deck's Markdown from its front matter and its slides. Each slide is Markdown, optionally with settings (layout: title, section, content, two-column, image, quote or blank; background, a colour; image, a picture's address; reveal: steps; transition: none, fade or slide) and notes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slides"
        ],
        "properties": {
          "front": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "theme": {
                "enum": [
                  "plain",
                  "paper",
                  "midnight"
                ]
              },
              "size": {
                "enum": [
                  "16:9",
                  "4:3"
                ]
              },
              "transition": {
                "enum": [
                  "none",
                  "fade",
                  "slide"
                ]
              }
            }
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "capabilities": [],
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/present@1",
      "title": "Open a Deck in Slides",
      "description": "Open Slides on a deck file for the person to see, at a slide; with present true, presenting from it.",
      "handles": "present",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "slide": {
            "type": "integer",
            "minimum": 1
          },
          "present": {
            "type": "boolean"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opened"
        ],
        "properties": {
          "opened": {
            "const": true
          },
          "view": {
            "enum": [
              "window",
              "tab"
            ]
          }
        }
      },
      "capabilities": [
        "window.open"
      ],
      "replay": "once"
    },
    {
      "ref": "yavc.slides/decks@1",
      "title": "The Open Decks",
      "description": "Every deck open in Slides, one tab each, and which is in front.",
      "live": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "active",
          "decks"
        ],
        "properties": {
          "active": {
            "type": "integer"
          },
          "decks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "title",
                "path",
                "modified",
                "slide",
                "count"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "modified": {
                  "type": "boolean"
                },
                "slide": {
                  "type": "integer"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "capabilities": [],
      "replay": "pure"
    },
    {
      "ref": "yavc.slides/switch@1",
