{
  "name": "editor",
  "title": "Editor",
  "version": "44.1.0",
  "description": "Edit text and Markdown files, with a preview, in CodeMirror.",
  "license": "Apache-2.0",
  "src": "editor.js",
  "css": "editor.css",
