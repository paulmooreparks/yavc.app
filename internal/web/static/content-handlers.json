        {
          "type": "mermaid",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text"
          ],
          "defaultView": "text"
        }
      ]
    },
    {
      "applet": "docs",
      "operation": "document",
      "kind": "file",
      "dispatch": {
        "command": "open"
      },
      "formats": [
        {
          "type": "markdown",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "document",
            "visual",
            "text",
            "split",
            "preview"
          ],
          "defaultView": "visual"
        },
        {
          "type": "document",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "document",
            "visual",
            "text",
            "split",
            "preview"
          ],
          "defaultView": "document"
        }
      ]
    },
    {
      "applet": "slides",
      "operation": "present",
      "kind": "file",
      "dispatch": {
        "command": "open"
      },
      "formats": [
        {
          "type": "slides",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "visual",
            "text",
            "split"
          ],
          "defaultView": "visual"
        }
      ]
    },
    {
      "applet": "diagrams",
      "operation": "diagram",
      "kind": "file",
      "dispatch": {
        "command": "open"
      },
      "formats": [
        {
          "type": "canvas",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "visual",
            "text",
            "split"
          ],
          "defaultView": "visual"
        },
        {
          "type": "d2",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "visual",
            "text",
            "split"
          ],
          "defaultView": "split"
