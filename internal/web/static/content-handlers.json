      "operation": "document",
      "view": "visual"
    },
    {
      "id": "mime-text",
      "match": {
        "mime": "text/plain"
      },
      "type": "text",
      "applet": "editor",
      "operation": "open",
      "view": "text"
    }
  ]
}
