      "operation": "diagram",
      "view": "split"
    },
    {
      "id": "mermaid-long",
      "match": {
        "suffix": ".mermaid"
      },
      "type": "mermaid",
      "applet": "diagrams",
      "operation": "diagram",
      "view": "split"
    },
    {
      "id": "text-file",
      "match": {
        "suffix": ".txt"
      },
      "type": "text",
      "applet": "editor",
      "operation": "open",
      "view": "text"
    },
    {
      "id": "json",
      "match": {
        "suffix": ".json"
      },
      "type": "text",
      "applet": "editor",
      "operation": "open",
      "view": "text"
    },
    {
      "id": "go",
      "match": {
        "suffix": ".go"
      },
      "type": "text",
      "applet": "editor",
      "operation": "open",
      "view": "text"
    },
    {
      "id": "cpp",
      "match": {
        "suffix": ".cpp"
      },
      "type": "text",
      "applet": "editor",
      "operation": "open",
