  "associations": [
    {
      "id": "markdown",
      "match": {
        "suffix": ".md"
      },
      "type": "markdown",
      "applet": "docs",
      "operation": "document",
      "view": "visual"
    },
    {
      "id": "markdown-long",
      "match": {
        "suffix": ".markdown"
      },
      "type": "markdown",
      "applet": "docs",
      "operation": "document",
      "view": "visual"
    },
    {
      "id": "document",
      "match": {
        "suffix": ".docs.md"
      },
      "type": "document",
      "applet": "docs",
      "operation": "document",
      "view": "document"
    },
    {
