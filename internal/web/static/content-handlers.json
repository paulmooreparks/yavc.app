{
  "version": 2,
  "types": [
    {
      "id": "text",
      "text": true,
      "matches": [
        {
          "suffix": ".txt"
        },
        {
          "suffix": ".go"
        },
        {
          "suffix": ".cpp"
        },
        {
          "suffix": ".json"
        },
        {
          "suffix": ".html"
        },
        {
          "suffix": ".css"
        },
        {
          "suffix": ".xfer"
        }
      ]
    },
    {
      "id": "markdown",
      "text": true,
      "matches": [
        {
          "suffix": ".md"
        },
        {
          "suffix": ".markdown"
        }
      ]
    },
    {
      "id": "document",
      "text": true,
      "matches": [
        {
          "suffix": ".docs.md"
        }
      ]
    },
    {
      "id": "slides",
      "text": true,
      "matches": [
        {
          "suffix": ".slides.md"
        }
      ]
    },
    {
      "id": "canvas",
      "text": true,
      "matches": [
        {
          "suffix": ".canvas"
        }
      ]
    },
    {
      "id": "d2",
      "text": true,
      "matches": [
        {
          "suffix": ".d2"
        }
      ]
    },
    {
      "id": "mermaid",
      "text": true,
      "matches": [
        {
          "suffix": ".mmd"
        },
        {
          "suffix": ".mermaid"
        }
      ]
    },
    {
      "id": "docx",
      "text": false,
      "matches": [
        {
          "suffix": ".docx"
        }
      ]
    },
    {
      "id": "pptx",
      "text": false,
      "matches": [
        {
          "suffix": ".pptx"
        }
      ]
    }
  ],
  "handlers": [
    {
      "applet": "editor",
      "operation": "open",
      "kind": "file",
      "dispatch": {
        "command": "open"
      },
      "formats": [
        {
          "type": "text",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text"
          ],
          "defaultView": "text"
        },
        {
          "type": "markdown",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text",
            "split",
            "preview"
          ],
          "defaultView": "text"
        },
        {
          "type": "document",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text",
            "split",
            "preview"
          ],
          "defaultView": "text"
        },
        {
          "type": "slides",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text"
          ],
          "defaultView": "text"
        },
        {
          "type": "canvas",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text"
          ],
          "defaultView": "text"
        },
        {
          "type": "d2",
          "intents": [
            "edit",
            "view"
          ],
          "views": [
            "text"
          ],
          "defaultView": "text"
