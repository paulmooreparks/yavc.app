# Copy to /opt/yavc/.env on the server and fill in. Never commit the real one.

# The release to run: a tag that .github/workflows/image.yml published, such as v0.1.0.
YAVC_TAG=v0.1.0

# The Cloudflare tunnel's token, from Zero Trust, Networks, Tunnels, the tunnel's
# Docker install command (the long string after --token).
TUNNEL_TOKEN=
