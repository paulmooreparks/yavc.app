{
  "id": "splash.asteroids",
  "version": "0.1.0",
  "apiVersion": 1,
  "title": "Asteroids",
  "description": "The arcade game.",
  "actions": [
    {
      "ref": "splash.asteroids/play@1",
      "title": "Play Asteroids",
      "description": "Open Asteroids for the person at the page and start a game, at the first wave or the one given.",
      "handles": "play",
      "inputSchema": {
        "type": "object", "additionalProperties": false,
        "properties": { "path": { "type": "string", "pattern": "^[1-9][0-9]?$", "default": "1", "description": "The wave to start at, 1 to 99." } }
      },
      "outputSchema": {
        "type": "object", "additionalProperties": false, "required": ["opened"],
        "properties": { "opened": { "const": true }, "view": { "enum": ["window", "tab"] } }
      },
      "capabilities": ["window.open"],
      "replay": "once"
    }
  ]
}
