{
  "name": "sight-reader",
  "title": "Sight Reader",
  "version": "1.4.2",
  "description": "Practise reading music: name each note of a score as a cursor reaches it.",
  "license": "Apache-2.0",
  "src": "sight-reader.js",
  "css": "sight-reader.css",
  "icon": "icon.svg",
  "page": { "body": "page.html" },
  "window": { "shape": "0.7,0.85" },
  "handles": { "open": { "param": "score", "kinds": ["score"] } },
  "actions": "actions.json",
  "wants": ["snapshot", "config"],
  "tags": ["web apps", "music"]
}
